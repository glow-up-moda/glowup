# Copiá este archivo como .env.local y completá los valores.
# .env.local nunca se sube al repositorio.
# En Netlify las mismas variables se cargan en Project configuration -> Environment variables.

# URL del sitio, sin barra al final
NEXT_PUBLIC_SITE_URL=

# Supabase: Project Settings -> API Keys
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Solo servidor: saltea RLS, nunca tiene que llegar al navegador
SUPABASE_SECRET_KEY=

# Ualá Bis (cobros con tarjeta), solo servidor.
# App o web de Ualá -> Ualá Bis -> Cobros online -> API.
# Credenciales de prueba hasta el lanzamiento; test y producción son distintas.
UALA_USERNAME=
UALA_CLIENT_ID=
UALA_CLIENT_SECRET=
UALA_ENVIRONMENT=test

# Resend (emails), solo servidor. El dominio de EMAIL_FROM tiene que estar
# verificado en Resend. EMAIL_INTERNAL es adónde llegan los avisos del panel
# (stock bajo, pedidos para revisar, transferencias por confirmar).
RESEND_API_KEY=
EMAIL_FROM="GLOW UP <hola@tudominio>"
EMAIL_INTERNAL=

# Secreto con el que la base llama a /api/cron/emails una vez por día.
# El mismo valor va en la tabla settings, en cron_secret, junto con
# cron_site_url. Sin esto, la ruta no atiende y el job no hace nada.
CRON_SECRET=

# Analítica
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GA4_ID=
