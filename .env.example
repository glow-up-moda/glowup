# Copiá este archivo como .env.local y completá los valores.
# .env.local nunca se sube al repositorio.
# En Netlify las mismas variables se cargan en Project configuration -> Environment variables.

# URL del sitio, sin barra al final
NEXT_PUBLIC_SITE_URL=

# Supabase: Project Settings -> API Keys
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Solo servidor: saltea RLS, nunca tiene que llegar al navegador
SUPABASE_SECRET_KEY=

# Mercado Pago, solo servidor. Credenciales de prueba hasta el lanzamiento
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

# Resend, solo servidor
RESEND_API_KEY=

# Analítica
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GA4_ID=
